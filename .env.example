# ─── Basalt environment ───────────────────────────────────────────────────────
# Copy to .env and adjust. `npm run setup` generates one for you with fresh keys.

NODE_ENV=development

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Public origin of the web app. Used for CORS, cookies and share-link building.
WEB_ORIGIN=http://localhost:3000
# Where the browser sends API calls.
#   · separate ports (this default): the browser talks to the API directly.
#     Required in development — the Next dev proxy drops bodies over ~10 MB.
#   · single origin behind one proxy: set this to /api and the Next rewrite in
#     apps/web/next.config.ts forwards to the API.
NEXT_PUBLIC_API_BASE=http://localhost:4000/api

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://basalt:basalt@localhost:5432/basalt
DATABASE_SSL=false
# Milliseconds a single statement may run before Postgres aborts it. Bounds the
# damage of a query stuck behind a lock. 0 disables.
DATABASE_STATEMENT_TIMEOUT=30000

# ─── Secrets (openssl rand -base64 48) ───────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-dev-only-access-secret-change-me-please
REFRESH_TOKEN_PEPPER=change-me-dev-only-refresh-pepper-change-me-please
ACCESS_TOKEN_TTL=900              # seconds  (15 min)
REFRESH_TOKEN_TTL=2592000         # seconds  (30 days)

# ─── Storage ─────────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/blobs

# S3 / any S3-compatible service (R2, MinIO, Wasabi, Spaces…)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=536870912        # 512 MB per file
DEFAULT_QUOTA_BYTES=10737418240   # 10 GB per user

# A ceiling on the bytes this deployment will ever put in the object store,
# across every account. 0 disables it. Per-account quotas cannot bound a bill —
# ten accounts at the 10 GB default is 100 GB — so on a metered bucket set this
# below the free allowance and leave a margin: the check is advisory before the
# transfer and binding at commit, so concurrent uploads can overshoot by up to
# one file each.
GLOBAL_STORAGE_LIMIT_BYTES=0
TRASH_RETENTION_DAYS=30

# Create the demo account and its fixture files at boot when it is absent. Only
# useful for a deployment somebody else is going to look at; a no-op once the
# account exists, so restarting will not delete what a visitor uploaded.
SEED_DEMO=false
