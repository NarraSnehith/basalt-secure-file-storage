{
  "name": "basalt",
  "version": "1.0.0",
  "private": true,
  "description": "Basalt — secure file storage service",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @basalt/api",
    "dev:web": "npm run dev --workspace @basalt/web",
    "build": "npm run build --workspace @basalt/api && npm run build --workspace @basalt/web",
    "start": "npm-run-all --parallel start:api start:web",
    "start:api": "npm run start --workspace @basalt/api",
    "start:web": "npm run start --workspace @basalt/web",
    "db:migrate": "npm run db:migrate --workspace @basalt/api",
    "db:reset": "npm run db:reset --workspace @basalt/api",
    "db:seed": "npm run db:seed --workspace @basalt/api",
    "test": "npm run test --workspace @basalt/api",
    "typecheck": "npm run typecheck --workspace @basalt/api && npm run typecheck --workspace @basalt/web",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": { "node": ">=20.11" }
}
